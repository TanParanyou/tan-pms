{
  "openapi": "3.0.3",
  "info": {
    "title": "tan-pms Enterprise Property Management System API",
    "version": "1.0.0",
    "description": "Single-Organization, Multi-Property PMS supporting Hourly, Daily, and Monthly StayModes with AdminScope and ClientScope isolation."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Dependencies are ready"
          }
        }
      }
    },
    "/api/v1/admin/properties/{propertyId}/rack": {
      "get": {
        "operationId": "getAdminRoomRack",
        "tags": ["AdminRack"],
        "parameters": [
          {
            "name": "propertyId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Unified Room Rack with structured projections",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RoomRackResponse" }
              }
            }
          },
          "403": {
            "description": "Property scope or permission denied",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/properties/{propertyId}/hierarchy": {
      "get": {
        "operationId": "getAdminPropertyHierarchy",
        "tags": ["AdminPropertyMaster"],
        "parameters": [
          {
            "name": "propertyId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Property hierarchy, buildings, floors, unit types, units, and assets",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PropertyHierarchyResponse" }
              }
            }
          },
          "403": {
            "description": "Property scope or permission denied",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/properties/{propertyId}/units": {
      "post": {
        "operationId": "upsertAdminUnitMaster",
        "tags": ["AdminPropertyMaster"],
        "parameters": [
          {
            "name": "propertyId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpsertUnitMasterRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unit master and assets created or updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnitMasterItemDto" }
              }
            }
          },
          "403": {
            "description": "Missing admin.properties.manage or unauthorized propertyId",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/stays/check-in": {
      "post": {
        "operationId": "checkInStay",
        "tags": ["AdminStay"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckInStayRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stay checked in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StaySummaryDto" }
              }
            }
          },
          "409": {
            "description": "Domain conflict (e.g. unit.not_clean, shift.not_open, reservation.slot_overlap)",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginAuthSession",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session for AdminScope or ClientScope",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentAuthSession",
        "tags": ["Auth"],
        "responses": {
          "200": {
            "description": "Current caller security context",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/roles": {
      "get": {
        "operationId": "getAdminRoleCatalog",
        "tags": ["AdminIdentity"],
        "responses": {
          "200": {
            "description": "Default enterprise roles and 24 canonical permission definitions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RoleCatalogResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "operationId": "getAdminUsers",
        "tags": ["AdminIdentity"],
        "parameters": [
          {
            "name": "propertyId",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Admin users scoped to caller AllowedPropertyIds",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminUserListResponse" }
              }
            }
          },
          "403": {
            "description": "Missing admin.users.read permission or unauthorized propertyId",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsResponse" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "upsertAdminUser",
        "tags": ["AdminIdentity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpsertAdminUserRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin user created or updated with audit trail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminUserDto" }
              }
            }
          },
          "403": {
            "description": "Missing admin.users.manage permission",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/notifications/dispatch": {
      "post": {
        "operationId": "dispatchAdminNotification",
        "tags": ["AdminNotifications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DispatchNotificationRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Notification dispatched via InApp / Line / Email adapter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationItemDto" }
              }
            }
          }
        }
      }
    },
    "/api/v1/client/dashboard": {
      "get": {
        "operationId": "getClientDashboard",
        "tags": ["ClientPortal"],
        "responses": {
          "200": {
            "description": "Client self-service overview scoped to CurrentUser.CustomerId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClientDashboardResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/client/notifications": {
      "get": {
        "operationId": "getClientNotifications",
        "tags": ["ClientPortal"],
        "responses": {
          "200": {
            "description": "Notifications scoped strictly to CurrentUser.CustomerId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationListResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetailsResponse": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "errorCode", "traceId"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "errorCode": { "type": "string" },
          "traceId": { "type": "string" },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "LocalizedTextDto": {
        "type": "object",
        "required": ["th"],
        "properties": {
          "th": { "type": "string" },
          "en": { "type": "string", "nullable": true }
        }
      },
      "PropertyRefDto": {
        "type": "object",
        "required": ["id", "code", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" }
        }
      },
      "UnitRefDto": {
        "type": "object",
        "required": ["id", "unitNumber", "buildingName", "floorNumber", "unitTypeName"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "unitNumber": { "type": "string" },
          "buildingName": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "floorNumber": { "type": "integer" },
          "unitTypeName": { "$ref": "#/components/schemas/LocalizedTextDto" }
        }
      },
      "CustomerRefDto": {
        "type": "object",
        "required": ["id", "fullName", "maskedNationalId"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "fullName": { "type": "string" },
          "maskedNationalId": { "type": "string" }
        }
      },
      "RoomRackItemDto": {
        "type": "object",
        "required": ["unit", "occupancyStatus", "conditionStatus", "supportedStayModes"],
        "properties": {
          "unit": { "$ref": "#/components/schemas/UnitRefDto" },
          "occupancyStatus": { "type": "string", "enum": ["Vacant", "Occupied", "Reserved", "Blocked"] },
          "conditionStatus": { "type": "string", "enum": ["Clean", "Dirty", "Cleaning", "Inspecting", "OutOfOrder"] },
          "supportedStayModes": {
            "type": "array",
            "items": { "type": "string", "enum": ["Hourly", "Daily", "Monthly"] }
          },
          "activeStayMode": { "type": "string", "nullable": true },
          "activeDocumentNumber": { "type": "string", "nullable": true },
          "customer": { "$ref": "#/components/schemas/CustomerRefDto" },
          "remainingMinutes": { "type": "integer", "nullable": true }
        }
      },
      "RoomRackResponse": {
        "type": "object",
        "required": ["property", "items"],
        "properties": {
          "property": { "$ref": "#/components/schemas/PropertyRefDto" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RoomRackItemDto" }
          }
        }
      },
      "CheckInStayRequest": {
        "type": "object",
        "required": ["propertyId", "unitId", "customerId", "stayMode", "keyDepositAmount"],
        "properties": {
          "propertyId": { "type": "string", "format": "uuid" },
          "unitId": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "stayMode": { "type": "string", "enum": ["Hourly", "Daily"] },
          "keyDepositAmount": { "type": "number", "format": "decimal" },
          "overrideDirtyCheckIn": { "type": "boolean" },
          "overrideReason": { "type": "string", "nullable": true }
        }
      },
      "StaySummaryDto": {
        "type": "object",
        "required": ["id", "documentNumber", "stayMode", "status", "unit", "customer"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "documentNumber": { "type": "string" },
          "stayMode": { "type": "string" },
          "status": { "type": "string" },
          "unit": { "$ref": "#/components/schemas/UnitRefDto" },
          "customer": { "$ref": "#/components/schemas/CustomerRefDto" }
        }
      },
      "ClientDashboardResponse": {
        "type": "object",
        "required": ["customer", "activeHoldReservation", "activeLease", "unpaidInvoices", "pendingParcels"],
        "properties": {
          "customer": { "$ref": "#/components/schemas/CustomerRefDto" },
          "activeHoldReservation": {
            "type": "object",
            "nullable": true,
            "properties": {
              "documentNumber": { "type": "string" },
              "unitTypeName": { "$ref": "#/components/schemas/LocalizedTextDto" },
              "stayMode": { "type": "string" },
              "holdExpiresAt": { "type": "string", "format": "date-time" },
              "depositAmount": { "type": "number" }
            }
          },
          "activeLease": {
            "type": "object",
            "nullable": true,
            "properties": {
              "documentNumber": { "type": "string" },
              "unit": { "$ref": "#/components/schemas/UnitRefDto" },
              "monthlyRentAmount": { "type": "number" },
              "securityDepositBalance": { "type": "number" }
            }
          },
          "unpaidInvoices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "documentNumber", "totalAmount", "status"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "documentNumber": { "type": "string" },
                "totalAmount": { "type": "number" },
                "status": { "type": "string" }
              }
            }
          },
          "pendingParcels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "documentNumber", "carrierName", "arrivedAt"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "documentNumber": { "type": "string" },
                "carrierName": { "type": "string" },
                "arrivedAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["scope", "identifier", "password"],
        "properties": {
          "scope": { "type": "string", "enum": ["admin", "client"] },
          "identifier": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": ["userId", "scope", "displayName", "roleCode", "roleName", "allowedProperties", "permissions", "accessToken"],
        "properties": {
          "userId": { "type": "string" },
          "scope": { "type": "string", "enum": ["admin", "client"] },
          "displayName": { "type": "string" },
          "roleCode": { "type": "string" },
          "roleName": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "allowedProperties": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PropertyRefDto" }
          },
          "permissions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "customer": { "$ref": "#/components/schemas/CustomerRefDto" },
          "accessToken": { "type": "string" }
        }
      },
      "RoleDefinitionDto": {
        "type": "object",
        "required": ["code", "name", "scope", "defaultPermissions"],
        "properties": {
          "code": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "scope": { "type": "string", "enum": ["AdminScope", "ClientScope"] },
          "defaultPermissions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "PermissionDefinitionDto": {
        "type": "object",
        "required": ["key", "moduleCode", "description", "isHighRisk"],
        "properties": {
          "key": { "type": "string" },
          "moduleCode": { "type": "string" },
          "description": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "isHighRisk": { "type": "boolean" }
        }
      },
      "RoleCatalogResponse": {
        "type": "object",
        "required": ["roles", "permissions"],
        "properties": {
          "roles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RoleDefinitionDto" }
          },
          "permissions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PermissionDefinitionDto" }
          }
        }
      },
      "AdminUserDto": {
        "type": "object",
        "required": ["id", "username", "fullName", "email", "roleCode", "roleName", "isActive", "allowedProperties", "permissions"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string" },
          "roleCode": { "type": "string" },
          "roleName": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "isActive": { "type": "boolean" },
          "allowedProperties": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PropertyRefDto" }
          },
          "permissions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "AdminUserListResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AdminUserDto" }
          }
        }
      },
      "UpsertAdminUserRequest": {
        "type": "object",
        "required": ["username", "fullName", "email", "roleCode", "allowedPropertyIds", "isActive"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "nullable": true },
          "username": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string" },
          "roleCode": { "type": "string" },
          "allowedPropertyIds": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "isActive": { "type": "boolean" }
        }
      },
      "DispatchNotificationRequest": {
        "type": "object",
        "required": ["propertyId", "customerId", "channel", "templateKey", "title", "body"],
        "properties": {
          "propertyId": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "channel": { "type": "string", "enum": ["InApp", "Line", "Email"] },
          "templateKey": { "type": "string" },
          "title": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "body": { "$ref": "#/components/schemas/LocalizedTextDto" }
        }
      },
      "NotificationItemDto": {
        "type": "object",
        "required": ["id", "channel", "templateKey", "title", "body", "isRead", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "channel": { "type": "string", "enum": ["InApp", "Line", "Email"] },
          "templateKey": { "type": "string" },
          "title": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "body": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "isRead": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "NotificationListResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NotificationItemDto" }
          }
        }
      },
      "PropertyDetailDto": {
        "type": "object",
        "required": ["id", "code", "taxBranchCode", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "taxBranchCode": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "address": { "$ref": "#/components/schemas/LocalizedTextDto" }
        }
      },
      "FloorDetailDto": {
        "type": "object",
        "required": ["id", "floorNumber", "name", "unitCount"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "floorNumber": { "type": "integer" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "unitCount": { "type": "integer" }
        }
      },
      "BuildingDetailDto": {
        "type": "object",
        "required": ["id", "code", "name", "floors"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "floors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FloorDetailDto" }
          }
        }
      },
      "UnitTypeDetailDto": {
        "type": "object",
        "required": ["id", "code", "name", "areaSqm", "totalQuotaUnits", "supportedStayModes", "hourlyBasePackagePrice", "dailyRate", "monthlyRentRate"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "description": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "areaSqm": { "type": "number" },
          "totalQuotaUnits": { "type": "integer" },
          "supportedStayModes": {
            "type": "array",
            "items": { "type": "string", "enum": ["Hourly", "Daily", "Monthly"] }
          },
          "hourlyBasePackagePrice": { "type": "number" },
          "dailyRate": { "type": "number" },
          "monthlyRentRate": { "type": "number" }
        }
      },
      "BuildingRefDto": {
        "type": "object",
        "required": ["id", "code", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" }
        }
      },
      "FloorRefDto": {
        "type": "object",
        "required": ["id", "floorNumber", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "floorNumber": { "type": "integer" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" }
        }
      },
      "UnitTypeRefDto": {
        "type": "object",
        "required": ["id", "code", "name", "areaSqm"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "areaSqm": { "type": "number" }
        }
      },
      "UnitAssetDto": {
        "type": "object",
        "required": ["id", "assetCode", "name", "replacementCostAmount"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "assetCode": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "replacementCostAmount": { "type": "number" }
        }
      },
      "UnitMasterItemDto": {
        "type": "object",
        "required": ["id", "unitNumber", "building", "floor", "unitType", "occupancyStatus", "conditionStatus", "supportedStayModes", "assets"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "unitNumber": { "type": "string" },
          "building": { "$ref": "#/components/schemas/BuildingRefDto" },
          "floor": { "$ref": "#/components/schemas/FloorRefDto" },
          "unitType": { "$ref": "#/components/schemas/UnitTypeRefDto" },
          "occupancyStatus": { "type": "string", "enum": ["Vacant", "Occupied", "Reserved", "Blocked"] },
          "conditionStatus": { "type": "string", "enum": ["Clean", "Dirty", "Cleaning", "Inspecting", "OutOfOrder"] },
          "supportedStayModes": {
            "type": "array",
            "items": { "type": "string", "enum": ["Hourly", "Daily", "Monthly"] }
          },
          "assets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UnitAssetDto" }
          }
        }
      },
      "PropertyHierarchyResponse": {
        "type": "object",
        "required": ["property", "buildings", "unitTypes", "units"],
        "properties": {
          "property": { "$ref": "#/components/schemas/PropertyDetailDto" },
          "buildings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BuildingDetailDto" }
          },
          "unitTypes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UnitTypeDetailDto" }
          },
          "units": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UnitMasterItemDto" }
          }
        }
      },
      "UpsertUnitAssetItemDto": {
        "type": "object",
        "required": ["assetCode", "name", "replacementCostAmount"],
        "properties": {
          "assetCode": { "type": "string" },
          "name": { "$ref": "#/components/schemas/LocalizedTextDto" },
          "replacementCostAmount": { "type": "number" }
        }
      },
      "UpsertUnitMasterRequest": {
        "type": "object",
        "required": ["buildingId", "floorId", "unitTypeId", "unitNumber", "supportedStayModes", "conditionStatus", "assets"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "nullable": true },
          "buildingId": { "type": "string", "format": "uuid" },
          "floorId": { "type": "string", "format": "uuid" },
          "unitTypeId": { "type": "string", "format": "uuid" },
          "unitNumber": { "type": "string" },
          "supportedStayModes": {
            "type": "array",
            "items": { "type": "string", "enum": ["Hourly", "Daily", "Monthly"] }
          },
          "conditionStatus": { "type": "string", "enum": ["Clean", "Dirty", "Cleaning", "Inspecting", "OutOfOrder"] },
          "assets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UpsertUnitAssetItemDto" }
          }
        }
      }
    }
  }
}
