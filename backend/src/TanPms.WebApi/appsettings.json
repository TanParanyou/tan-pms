{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    // Local-development default only. Override with ConnectionStrings__DefaultConnection in every deployed environment.
    "DefaultConnection": "Host=localhost;Port=5432;Database=tan_pms;Username=postgres;Password=postgres"
  },
  "Auth": {
    // Jwt (default) | Headers. Headers trusts X-TanPms-* headers and is refused outside Development/Testing.
    "Mode": "Jwt",
    "Jwt": {
      // Secret, never committed: set Auth__Jwt__SigningKey (>= 32 bytes). Start-up fails outside Development/Testing when missing/short.
      "SigningKey": "",
      "Issuer": "tan-pms",
      "Audience": "tan-pms-web",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7,
      "RequireHttpsMetadata": true
    },
    "Lockout": {
      "Threshold": 5,
      "Minutes": 15
    },
    "RateLimit": {
      // Fixed window per client IP on POST /api/v1/auth/login and /api/v1/auth/refresh.
      "Enabled": true,
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Storage": {
    // Private folder for uploaded files; empty = <app>/App_Data/files.
    "RootPath": ""
  },
  "Billing": {
    "OverdueSweepIntervalMinutes": 60
  },
  "Seed": {
    // Password given to seeded demo accounts. Applied only in Development/Testing; ignored in every other environment.
    "DevPassword": ""
  }
}
