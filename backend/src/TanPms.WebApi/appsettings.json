{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "Postgres"
  },
  // ConnectionStrings:DefaultConnection carries no committed credentials: set ConnectionStrings__DefaultConnection in every
  // deployed environment (start-up fails outside Development/Testing when missing, unless Persistence:Provider=InMemory).
  // Development uses appsettings.Development.json.
  "Auth": {
    // Jwt (default) | Headers. Headers trusts X-TanPms-* headers and is refused outside Development/Testing.
    "Mode": "Jwt",
    "Jwt": {
      // Secret, never committed: set Auth__Jwt__SigningKey (>= 32 bytes). Start-up fails outside Development/Testing when missing/short.
      "SigningKey": "",
      "Issuer": "tan-pms",
      "Audience": "tan-pms-web",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7,
      "RequireHttpsMetadata": true,
      // Id written to the token kid header for the current key. Rotate: move the old key to PreviousSigningKeys
      // ({ "KeyId": "k1", "Key": "<>=32 bytes>" }; env Auth__Jwt__PreviousSigningKeys__0__KeyId / __Key) and set a new SigningKey + KeyId.
      "KeyId": "k1",
      // Rotated refresh token presented again within this window is a benign race (401, family kept); later = theft (family revoked).
      "RefreshReuseGraceSeconds": 10,
      // Cleanup deletes refresh tokens expired or revoked more than this many days ago, every CleanupIntervalMinutes.
      "RefreshTokenRetentionDays": 30,
      "CleanupIntervalMinutes": 60
    },
    "Lockout": {
      "Threshold": 5,
      "Minutes": 15
    },
    "RateLimit": {
      // Fixed window per client IP on POST /api/v1/auth/login and /api/v1/auth/refresh.
      "Enabled": true,
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Security": {
    // HSTS header outside Development/Testing over HTTPS.
    "Hsts": { "Enabled": true }
  },
  "Storage": {
    // Private folder for uploaded files; empty = <app>/App_Data/files.
    "RootPath": ""
  },
  "Billing": {
    "OverdueSweepIntervalMinutes": 60
  },
  "Seed": {
    // Password given to seeded demo accounts. Applied only in Development/Testing; ignored in every other environment.
    "DevPassword": ""
  }
}
