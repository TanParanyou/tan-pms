{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    // Local docker-compose Postgres only; never reuse outside a developer machine.
    "DefaultConnection": "Host=localhost;Port=5432;Database=tan_pms;Username=postgres;Password=postgres"
  },
  "Auth": {
    "Jwt": {
      // DEV-ONLY signing key for local machines. Never reuse it in any shared or deployed environment.
      "SigningKey": "dev-only-tan-pms-signing-key-not-for-production-0001",
      "RequireHttpsMetadata": false
    }
  },
  "Seed": {
    // DEV-ONLY demo password for the seeded logins listed in PmsSeedConstants.
    "DevPassword": "demo-pass-123"
  }
}
