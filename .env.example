# =================================================================
# TAN-PMS ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Single-Organization Multi-Property PMS (Hourly, Daily, Monthly)
# =================================================================

# -----------------------------------------------------------------
# 1. Database (PostgreSQL 17 + PostGIS)
# -----------------------------------------------------------------
POSTGRES_DB=tan_pms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tan_pms;Username=postgres;Password=postgres

# -----------------------------------------------------------------
# 2. Security & PDPA / PII Masking
# -----------------------------------------------------------------
# JWT Signing Key (Minimum 256 bits for HMAC-SHA256)
Security__JwtSigningKey=development_super_secret_jwt_signing_key_min_256_bits_length_12345

# AES-256 Key (64 hex characters / 32 bytes) for encrypting Citizen ID / Passport PII
Security__PiiEncryptionKey=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 Key (64 hex characters / 32 bytes) for deterministic identity_hash blind index
Security__PiiBlindIndexKey=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# -----------------------------------------------------------------
# 3. Private File Storage (Deferred Upload)
# -----------------------------------------------------------------
# Options: Local | S3Compatible
Storage__Provider=Local
Storage__LocalStoragePath=./.local-storage
Storage__PrivateBucketName=tan-pms-private-storage

# -----------------------------------------------------------------
# 4. Frontend & Service Ports
# -----------------------------------------------------------------
PORT=3000
FE_PORT=3000
BE_PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DEFAULT_LOCALE=th
