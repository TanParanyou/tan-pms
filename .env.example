# =================================================================
# TAN-PMS ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Single-Organization Multi-Property PMS (Hourly, Daily, Monthly)
# =================================================================

# -----------------------------------------------------------------
# 1. Database (PostgreSQL 17 + PostGIS)
# -----------------------------------------------------------------
# POSTGRES_* are read by docker-compose.yml only (not by the backend).
POSTGRES_DB=tan_pms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Read by the backend (GetConnectionString("DefaultConnection") and TanPmsDbContextFactory for EF tooling)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tan_pms;Username=postgres;Password=postgres
# Persistence:Provider = Postgres (default) | InMemory (tests/demo without a database)
Persistence__Provider=Postgres

# -----------------------------------------------------------------
# 2. Billing
# -----------------------------------------------------------------
# Interval (minutes, minimum 1) of the OverdueInvoiceSweeper background service. Default 60.
Billing__OverdueSweepIntervalMinutes=60

# -----------------------------------------------------------------
# 3. Private File Storage (StoredFile, local-disk provider)
# -----------------------------------------------------------------
# Read by the backend. Default when unset: <app base dir>/App_Data/files. Files are never served statically.
Storage__RootPath=./.local-storage

# -----------------------------------------------------------------
# 4. RESERVED - not read by the backend yet (planned security / PDPA / S3 work)
# -----------------------------------------------------------------
# JWT Signing Key (Minimum 256 bits for HMAC-SHA256)
Security__JwtSigningKey=development_super_secret_jwt_signing_key_min_256_bits_length_12345
# AES-256 Key (64 hex characters / 32 bytes) for encrypting Citizen ID / Passport PII
Security__PiiEncryptionKey=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# HMAC-SHA256 Key (64 hex characters / 32 bytes) for deterministic identity_hash blind index
Security__PiiBlindIndexKey=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
# Object storage provider switch; only the local-disk provider exists today (use Storage__RootPath)
Storage__Provider=Local
Storage__PrivateBucketName=tan-pms-private-storage

# -----------------------------------------------------------------
# 5. Frontend & Service Ports
# -----------------------------------------------------------------
# Only NEXT_PUBLIC_API_URL is read by frontend code; PORT, FE_PORT, BE_PORT and NEXT_PUBLIC_DEFAULT_LOCALE are reserved.
PORT=3000
FE_PORT=3000
BE_PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DEFAULT_LOCALE=th
