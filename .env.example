# =================================================================
# TAN-PMS ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Single-Organization Multi-Property PMS (Hourly, Daily, Monthly)
# =================================================================

# -----------------------------------------------------------------
# 1. Database (PostgreSQL 17 + PostGIS)
# -----------------------------------------------------------------
# POSTGRES_* are read by docker-compose.yml only (not by the backend).
POSTGRES_DB=tan_pms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Read by the backend (GetConnectionString("DefaultConnection") and TanPmsDbContextFactory for EF tooling).
# REQUIRED outside Development/Testing (start-up fails when missing, unless Persistence__Provider=InMemory); use real credentials there, never these local defaults.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tan_pms;Username=postgres;Password=postgres
# Persistence:Provider = Postgres (default) | InMemory (tests/demo without a database)
Persistence__Provider=Postgres

# -----------------------------------------------------------------
# 2. Billing
# -----------------------------------------------------------------
# Interval (minutes, minimum 1) of the OverdueInvoiceSweeper background service. Default 60.
Billing__OverdueSweepIntervalMinutes=60

# -----------------------------------------------------------------
# 3. Private File Storage (StoredFile, local-disk provider)
# -----------------------------------------------------------------
# Read by the backend. Default when unset: <app base dir>/App_Data/files. Files are never served statically.
Storage__RootPath=./.local-storage

# -----------------------------------------------------------------
# 4. Authentication (JWT) - see docs/adr/0011-authentication-with-own-jwt.md
# -----------------------------------------------------------------
# Jwt (default) | Headers. Headers trusts X-TanPms-* headers; the backend refuses to start with it outside Development/Testing.
Auth__Mode=Jwt
# REQUIRED outside Development/Testing (start-up fails when missing or shorter than 32 bytes). NEVER commit a real value.
# Generate >= 32 random bytes, e.g.:  openssl rand -base64 48
Auth__Jwt__SigningKey=
Auth__Jwt__Issuer=tan-pms
Auth__Jwt__Audience=tan-pms-web
Auth__Jwt__AccessTokenMinutes=15
Auth__Jwt__RefreshTokenDays=7
# Key rotation: current key id (token header `kid`) and previous keys accepted for validation only (>= 32 bytes each).
Auth__Jwt__KeyId=k1
# Auth__Jwt__PreviousSigningKeys__0__KeyId=k0
# Auth__Jwt__PreviousSigningKeys__0__Key=
# Same refresh token presented again within this grace window is rejected without revoking the token family.
Auth__Jwt__RefreshReuseGraceSeconds=10
# Refresh token cleanup: delete rows expired/revoked longer than RetentionDays ago, run every CleanupIntervalMinutes.
Auth__Jwt__RefreshTokenRetentionDays=30
Auth__Jwt__CleanupIntervalMinutes=60
# Default: true outside Development/Testing, false inside.
Auth__Jwt__RequireHttpsMetadata=true
# Account lockout: Threshold failed logins lock the account for Minutes.
Auth__Lockout__Threshold=5
Auth__Lockout__Minutes=15
# Fixed window per client IP on POST /api/v1/auth/login and /api/v1/auth/refresh.
Auth__RateLimit__Enabled=true
Auth__RateLimit__PermitLimit=10
Auth__RateLimit__WindowSeconds=60
# DEV ONLY: password given to seeded demo accounts (applied only in Development/Testing, ignored elsewhere).
# Never set this in production. Leave empty here; the local value lives in appsettings.Development.json.
Seed__DevPassword=
# HSTS response header outside Development/Testing when served over HTTPS.
Security__Hsts__Enabled=true

# -----------------------------------------------------------------
# 5. RESERVED - not read by the backend yet (planned security / PDPA / S3 work)
# -----------------------------------------------------------------
# (JWT signing now uses Auth__Jwt__SigningKey above; Security__JwtSigningKey was removed.)
# AES-256 Key (64 hex characters / 32 bytes) for encrypting Citizen ID / Passport PII
Security__PiiEncryptionKey=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# HMAC-SHA256 Key (64 hex characters / 32 bytes) for deterministic identity_hash blind index
Security__PiiBlindIndexKey=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
# Object storage provider switch; only the local-disk provider exists today (use Storage__RootPath)
Storage__Provider=Local
Storage__PrivateBucketName=tan-pms-private-storage

# -----------------------------------------------------------------
# 6. Frontend & Service Ports
# -----------------------------------------------------------------
# Only NEXT_PUBLIC_API_URL is read by frontend code; PORT, FE_PORT, BE_PORT and NEXT_PUBLIC_DEFAULT_LOCALE are reserved.
PORT=3000
FE_PORT=3000
BE_PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DEFAULT_LOCALE=th
